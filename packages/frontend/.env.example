# Get your project ID from https://cloud.walletconnect.com
NEXT_PUBLIC_DEWORK_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DISPUTE_RESOLUTION_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id

# Blockchain Configuration
NEXT_PUBLIC_DEWORK_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ENS_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ENS_RESOLVER_ADDRESS=0x0000000000000000000000000000000000000000

# Network Configuration
NEXT_PUBLIC_NETWORK_ID=5 # Goerli testnet
NEXT_PUBLIC_RPC_URL=https://goerli.infura.io/v3/your_infura_project_id

# Circle API Configuration
NEXT_PUBLIC_CIRCLE_API_URL=https://api.circle.com/v1
